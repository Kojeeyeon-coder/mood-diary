rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEntry(entryId) {
      return request.resource.data.keys().hasOnly([
          'date', 'emotion', 'note', 'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && request.resource.data.date == entryId
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.emotion in [
          'happy', 'excited', 'calm', 'neutral',
          'mixed', 'sad', 'irritated', 'angry'
        ]
        && request.resource.data.note is string
        && request.resource.data.note.size() >= 1
        && request.resource.data.note.size() <= 100
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.schemaVersion == 1;
    }

    match /users/{userId}/entries/{entryId} {
      allow read, delete: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId) && validEntry(entryId);
    }
  }
}
